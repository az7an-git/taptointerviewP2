import authApi from "./authApi";
import publicApi from "./publicApi";
import {
  normalizeWindowIsoFromApi,
  windowIsoToApi,
} from "@/common/utils/queueWindowDatetime";
import { parseServerTimeMs } from "@/common/utils/serverClock";
import {
  Job,
  JobReview,
  ComplianceReviewResult,
  ScreeningQuestion,
  ScreeningQuestionOption,
  QueueWindow,
  QueueWindowLiveStatusPayload,
  JobApplicant,
  QueueEntryOutcome,
} from "@/types/job";

const mapScreeningOptionFromBackend = (opt: any): ScreeningQuestionOption => ({
  text: opt.text,
  isDealBreaker: opt.is_deal_breaker ?? false,
  sortOrder: opt.sort_order !== undefined ? Number(opt.sort_order) : 0,
});

const mapScreeningQuestionFromBackend = (q: any): ScreeningQuestion => ({
  id: q.id,
  text: q.text,
  sortOrder: q.sort_order !== undefined ? Number(q.sort_order) : 0,
  complianceStatus: q.compliance_status,
  complianceNotes: q.compliance_notes ?? null,
  options: (q.options || [])
    .map(mapScreeningOptionFromBackend)
    .sort(
      (a: ScreeningQuestionOption, b: ScreeningQuestionOption) =>
        (a.sortOrder ?? 0) - (b.sortOrder ?? 0)
    ),
});

const mapScreeningQuestionToBackend = (q: ScreeningQuestion) => ({
  text: q.text,
  options: q.options.map((opt) => ({
    text: opt.text,
    is_deal_breaker: opt.isDealBreaker,
  })),
});

const capitalizeStatus = (status: string): QueueWindow["status"] => {
  const normalized = status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
  if (normalized === "Scheduled" || normalized === "Open" || normalized === "Closed" || normalized === "Paused") {
    return normalized;
  }
  return "Scheduled";
};

const mapQueueWindowFromBackend = (w: any): QueueWindow => ({
  id: w.id,
  startTime: normalizeWindowIsoFromApi(w.starts_at),
  endTime: normalizeWindowIsoFromApi(w.ends_at),
  status: w.status ? capitalizeStatus(w.status) : "Scheduled",
});

const mapApplicantFromBackend = (a: any): JobApplicant => {
  let status = a.status;
  // WORKAROUND: If outcome is set and status incorrectly matches an outcome value, force it to 'resolved'
  if (a.outcome && (status === "admitted" || status === "declined" || status === "pending_review")) {
    status = "resolved";
  }

  return {
    queueEntryId: a.queue_entry_id,
    status: status,
    joinedAt: a.joined_at,
    calledAt: a.called_at,
    admissionExpiresAt: a.admission_expires_at,
    sessionStartedAt: a.session_started_at ?? null,
    sessionEndedAt: a.session_ended_at ?? null,
    sessionDurationSeconds:
      a.session_duration_seconds !== undefined && a.session_duration_seconds !== null
        ? Number(a.session_duration_seconds)
        : null,
    outcome: a.outcome ?? null,
    createdAt: a.created_at,
    updatedAt: a.updated_at,
    participant: {
      id: a.participant?.id,
      firstName: a.participant?.first_name,
      lastName: a.participant?.last_name,
      email: a.participant?.email,
      phone: a.participant?.phone,
    },
  };
};

const mapQueueWindowToBackend = (w: QueueWindow) => ({
  starts_at: windowIsoToApi(w.startTime),
  ends_at: windowIsoToApi(w.endTime),
});

const mapToBackend = (job: Partial<Job>): any => {
  const backend: any = {};
  if (job.id !== undefined) backend.id = job.id;
  if (job.title !== undefined) backend.title = job.title;
  if (job.location !== undefined) backend.location = job.location;
  if (job.type !== undefined) backend.employment_type = job.type.toLowerCase();
  if (job.salaryMin !== undefined && Number(job.salaryMin) > 0) backend.salary_range_from = Number(job.salaryMin);
  if (job.salaryMax !== undefined && Number(job.salaryMax) > 0) backend.salary_range_to = Number(job.salaryMax);
  if (job.department !== undefined) backend.department = job.department;
  if (job.description !== undefined) backend.description = job.description;
  if (job.requirements !== undefined) backend.requirements = job.requirements;
  if (job.companyId !== undefined) backend.company_id = job.companyId;
  return backend;
};

const mapComplianceReviewFromBackend = (backend: any): ComplianceReviewResult => ({
  jobId: backend?.job_id ?? "",
  reviewedCount: backend?.reviewed_count !== undefined ? Number(backend.reviewed_count) : 0,
  reviewedWithClaudeCount:
    backend?.reviewed_with_claude_count !== undefined
      ? Number(backend.reviewed_with_claude_count)
      : 0,
  skippedApprovedCount:
    backend?.skipped_approved_count !== undefined ? Number(backend.skipped_approved_count) : 0,
  screeningQuestions: (backend?.screening_questions || []).map(mapScreeningQuestionFromBackend),
});

const mapJobReviewFromBackend = (backend: any): JobReview => ({
  ready: Boolean(backend?.ready),
  jobStatus: backend?.job_status ?? "",
  title: backend?.title ?? "",
  screeningQuestions: backend?.screening_questions !== undefined ? Number(backend.screening_questions) : 0,
  dealBreakerAnswers: backend?.deal_breaker_answers !== undefined ? Number(backend.deal_breaker_answers) : 0,
  interviewWindows: backend?.interview_windows !== undefined ? Number(backend.interview_windows) : 0,
  creditsRequired: backend?.credits_required ?? "",
  canPublish: Boolean(backend?.can_publish),
  publishErrors: Array.isArray(backend?.publish_errors) ? backend.publish_errors : [],
});

const extractReviewPayload = (responseData: any) => {
  if (!responseData) return null;
  if (responseData.ready !== undefined || responseData.can_publish !== undefined) {
    return responseData;
  }
  return responseData.data ?? null;
};

const mapToFrontend = (backend: any): Job => {
  return {
    id: backend.id,
    companyId: backend.company_id,
    title: backend.title,
    location: backend.location,
    type: backend.employment_type ? (backend.employment_type.charAt(0).toUpperCase() + backend.employment_type.slice(1)) : "Full-time",
    salaryMin: backend.salary_range_from ? Number(backend.salary_range_from) : 0,
    salaryMax: backend.salary_range_to ? Number(backend.salary_range_to) : 0,
    department: backend.department || "",
    requirements: backend.requirements || "",
    description: backend.description || "",
    status: backend.status ? (backend.status.charAt(0).toUpperCase() + backend.status.slice(1)) as any : "Draft",
    createdAt: backend.created_at,
    updatedAt: backend.updated_at,
    screeningQuestions: (backend.screening_questions || []).map(mapScreeningQuestionFromBackend),
    queueWindows: (backend.windows || []).map(mapQueueWindowFromBackend),
    queueCount: backend.queue_count !== undefined ? Number(backend.queue_count) : (backend.queueCount || 0),
    totalCount: backend.total_count !== undefined ? Number(backend.total_count) : (backend.totalCount || 0),
    applicants: (backend.applicants || []).map(mapApplicantFromBackend),
  };
};

export const JOB_LIST_STATUSES = ["draft", "active", "paused", "closed"] as const;
export type JobListStatus = (typeof JOB_LIST_STATUSES)[number];

export const JOB_EMPLOYMENT_TYPES = [
  "full-time",
  "part-time",
  "contract",
  "freelance",
  "internship",
] as const;
export type JobEmploymentType = (typeof JOB_EMPLOYMENT_TYPES)[number];

export interface JobsListParams {
  page?: number;
  limit?: number;
  status?: JobListStatus | string;
  employment_type?: JobEmploymentType | string;
  /** Partial match on job title (backend `search` query param) */
  search?: string;
}

export interface CompanyJobsListParams {
  page?: number;
  limit?: number;
  employment_type?: JobEmploymentType | string;
  /** Partial match on job title (backend `search` query param) */
  search?: string;
}

export interface JobsPagination {
  page: number;
  limit: number;
  total: number;
  totalPages: number;
}

const normalizeAllowedParam = (
  value: string | undefined,
  allowed: readonly string[]
): string | undefined => {
  if (!value?.trim()) return undefined;
  const normalized = value.trim().toLowerCase();
  return allowed.includes(normalized) ? normalized : undefined;
};

const appendEmploymentTypeAndSearch = (
  query: Record<string, string | number>,
  params?: { employment_type?: string; search?: string }
) => {
  const employmentType = normalizeAllowedParam(params?.employment_type, JOB_EMPLOYMENT_TYPES);
  if (employmentType) query.employment_type = employmentType;

  const search = params?.search?.trim().slice(0, 255);
  if (search) query.search = search;
};

const buildJobsListQuery = (params?: JobsListParams) => {
  const query: Record<string, string | number> = {};
  if (params?.page !== undefined) query.page = params.page;
  if (params?.limit !== undefined) query.limit = params.limit;

  const status = normalizeAllowedParam(params?.status, JOB_LIST_STATUSES);
  if (status) query.status = status;

  appendEmploymentTypeAndSearch(query, params);
  return query;
};

const buildCompanyJobsListQuery = (params?: CompanyJobsListParams) => {
  const query: Record<string, string | number> = {};
  if (params?.page !== undefined) query.page = params.page;
  if (params?.limit !== undefined) query.limit = params.limit;
  appendEmploymentTypeAndSearch(query, params);
  return query;
};

const mapPaginationFromBackend = (pagination?: any): JobsPagination => ({
  page: pagination?.page ?? 1,
  limit: pagination?.limit ?? 10,
  total: pagination?.total ?? 0,
  totalPages: pagination?.total_pages ?? 1,
});

export const jobsApi = {
  getJobs: async (params?: JobsListParams) => {
    const response = await authApi.get<{ status: string; data: { jobs: any[]; pagination?: any } }>(
      "/jobs",
      { params: buildJobsListQuery(params) }
    );
    const jobsList = response.data.data?.jobs || [];
    return {
      data: jobsList.map(mapToFrontend),
      pagination: mapPaginationFromBackend(response.data.data?.pagination),
    };
  },
  getActiveQueues: async () => {
    const response = await authApi.get<{
      status: string;
      data: { active_queues: any[] };
    }>("/jobs/queues/active");

    // MyQueuePage
    return {
      data: (response.data.data?.active_queues || []).map((aq) => ({
        id: aq.job_id,
        title: aq.title,
        location: aq.location,
        type: aq.employment_type ? (aq.employment_type.charAt(0).toUpperCase() + aq.employment_type.slice(1)) : "Full-time",
        status: "Active" as any,
        queueWindows: (aq.windows || aq.queue_windows || []).map(mapQueueWindowFromBackend),
        queuePauseStatus: aq.queue_pause_status as string | undefined,
        applicants: (aq.queue || []).map(mapApplicantFromBackend)
      })) as Job[]
    };
  },
  getJob: async (id: string) => {
    const response = await authApi.get<{ status: string; data: any }>(`/jobs/${id}`);
    return { data: mapToFrontend(response.data.data) };
  },
  getJobReview: async (id: string) => {
    const response = await authApi.get<{ status: string; data: any }>(`/jobs/${id}/review`);
    const payload = extractReviewPayload(response.data);
    if (!payload) {
      throw new Error("Invalid review response from server");
    }
    return { data: mapJobReviewFromBackend(payload) };
  },
  createJob: async (data: Partial<Job>) => {
    const response = await authApi.post<{ status: string; data: any }>("/jobs", mapToBackend(data));
    return { data: mapToFrontend(response.data.data) };
  },
  updateJob: async (id: string, data: Partial<Job>) => {
    const response = await authApi.put<{ status: string; data: any }>(`/jobs/${id}`, mapToBackend(data));
    return { data: mapToFrontend(response.data.data) };
  },
  publishJob: async (id: string) => {
    const response = await authApi.post<{ status: string; data: any }>(`/jobs/${id}/publish`);
    return { data: mapToFrontend(response.data.data) };
  },
  closeJob: async (id: string) => {
    const response = await authApi.post<{ status: string; data: any }>(`/jobs/${id}/close`);
    return { data: mapToFrontend(response.data.data) };
  },

  saveScreeningQuestions: async (jobId: string, questions: ScreeningQuestion[]) => {
    const response = await authApi.put<{ status: string; data: any }>(
      `/jobs/${jobId}/screening-questions`,
      { screening_questions: questions.map(mapScreeningQuestionToBackend) }
    );
    return { data: mapToFrontend(response.data.data) };
  },

  runComplianceReview: async (jobId: string) => {
    const response = await authApi.post<{ status: string; data: any }>(
      `/jobs/${jobId}/compliance-review`
    );
    const payload = response.data?.data;
    if (!payload) {
      throw new Error("Invalid compliance review response from server");
    }
    return { data: mapComplianceReviewFromBackend(payload) };
  },

  saveQueueWindows: async (jobId: string, windows: QueueWindow[]) => {
    const response = await authApi.put<{ status: string; data: any }>(
      `/jobs/${jobId}/windows`,
      { windows: windows.map(mapQueueWindowToBackend) }
    );
    return { data: mapToFrontend(response.data.data) };
  },

  /** Pause or resume the live queue window (PUT .../windows/status). */
  updateQueueWindowStatus: async (jobId: string, status: QueueWindowLiveStatusPayload) => {
    const response = await authApi.put<{ status: string; data: any }>(
      `/jobs/${jobId}/windows/status`,
      { status }
    );
    return { data: mapToFrontend(response.data.data) };
  },

  getCompanyJobs: async (slug: string, params?: CompanyJobsListParams) => {
    const response = await authApi.get<{
      status: string;
      data: {
        company: {
          id: string;
          company_name: string;
          company_slug: string;
          company_url: string;
        };
        jobs: any[];
        pagination?: {
          page: number;
          limit: number;
          total: number;
          total_pages: number;
        };
      };
    }>(`/jobs/company/${slug}`, { params: buildCompanyJobsListQuery(params) });
    const payload = response.data.data;
    const serverTimeMs = parseServerTimeMs(
      response.data,
      response.headers?.date ?? response.headers?.Date ?? null
    );
    return {
      status: response.data.status,
      data: {
        company: payload.company,
        jobs: payload.jobs || [],
      },
      pagination: mapPaginationFromBackend(payload.pagination),
      serverTimeMs,
    };
  },

  getJobDetailsByCompany: async (slug: string, jobId: string) => {
    const response = await publicApi.get<{
      status: string;
      data: {
        company: {
          id: string;
          company_name: string;
          company_slug: string;
          company_url: string;
        };
        job: any; // Using any here to match backend structure directly
      };
    }>(`/jobs/company/${slug}/${jobId}`);
    return {
      status: response.data.status,
      data: {
        company: response.data.data.company,
        job: response.data.data.job,
      },
    };
  },

  submitScreeningAnswers: async (slug: string, jobId: string, answers: any[]) => {
    const response = await publicApi.post<{
      status: string;
      data: {
        passed: boolean;
        screening_attempt_id: string;
        screening_token: string;
      };
    }>(`/jobs/company/${slug}/${jobId}/screening`, { answers });
    return response.data;
  },

  joinQueue: async (
    slug: string,
    jobId: string,
    payload: {
      first_name: string;
      last_name: string;
      email: string;
      phone?: string;
      sms_consent: boolean;
      email_consent: boolean;
    },
    screeningToken?: string
  ) => {
    const response = await publicApi.post<{
      status: string;
      data: {
        queue_entry_id: string;
        participant_id: string;
        position: number;
        participant_token: string;
      };
    }>(`/jobs/company/${slug}/${jobId}/queue/join`, payload, {
      headers: screeningToken
        ? { Authorization: `Bearer ${screeningToken}` }
        : {},
    });
    return response.data;
  },

  /**
   * Admit the next waiting participant in the queue.
   * POST /api/v1/jobs/:jobId/queue/admit-next
   * Auth: Host JWT (admin or interviewer)
   */
  admitNextParticipant: async (jobId: string) => {
    const response = await authApi.post<{
      status: string;
      data: {
        queue_entry_id: string;
        job_id: string;
        status: string;
        called_at: string;
        admission_expires_at: string;
        remaining_seconds: number;
        balance: number;
        participant: {
          id: string;
          first_name: string;
          last_name: string;
          email: string;
        };
        email_sent: boolean;
      };
    }>(`/jobs/${jobId}/queue/admit-next`);
    return response.data;
  },

  /**
   * Start the interview session for an admitted participant.
   * POST /api/v1/jobs/:jobId/queue/:queueEntryId/session/start
   */
  startSession: async (jobId: string, queueEntryId: string) => {
    const response = await authApi.post<{ status: string; data: any }>(
      `/jobs/${jobId}/queue/${queueEntryId}/session/start`
    );
    const entry = response.data.data;
    return {
      status: response.data.status,
      data: entry ? mapApplicantFromBackend(entry) : null,
    };
  },

  /**
   * End the interview session and move to pending outcome.
   * POST /api/v1/jobs/:jobId/queue/:queueEntryId/session/end
   */
  endSession: async (jobId: string, queueEntryId: string) => {
    const response = await authApi.post<{ status: string; data: any }>(
      `/jobs/${jobId}/queue/${queueEntryId}/session/end`
    );
    const entry = response.data.data;
    return {
      status: response.data.status,
      data: entry ? mapApplicantFromBackend(entry) : null,
    };
  },

  /**
   * Save the interview outcome before calling the next participant.
   * POST /api/v1/jobs/:jobId/queue/:queueEntryId/outcome
   */
  saveOutcome: async (
    jobId: string,
    queueEntryId: string,
    outcome: QueueEntryOutcome
  ) => {
    const response = await authApi.post<{ status: string; data: any }>(
      `/jobs/${jobId}/queue/${queueEntryId}/outcome`,
      { outcome }
    );
    const entry = response.data.data;
    return {
      status: response.data.status,
      data: entry ? mapApplicantFromBackend(entry) : null,
    };
  },
};
